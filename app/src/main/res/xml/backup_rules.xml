<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!--
      规则：只显式 include 需要云端备份的内容，未 include 的 SharedPreferences 和文件默认不参与备份。
      不要对同一个 path 同时使用 include + exclude，lint 会报冲突。
      敏感文件（opedrgent_secure、opedrgent_webdav、mcp_servers）因未被 include，自然不会被备份。
    -->

    <!-- 用户设置与数据需要备份：卸载重装后可恢复 -->
    <include domain="sharedpref" path="opedrgent_settings" />
    <include domain="sharedpref" path="opedrgent_memory" />
    <include domain="sharedpref" path="opedrgent_skills" />
    <include domain="sharedpref" path="opedrgent_automations" />
    <include domain="sharedpref" path="opedrgent_todos" />
    <include domain="sharedpref" path="opedrgent_skill_loader" />
    <include domain="sharedpref" path="opedrgent_user" />
    <include domain="sharedpref" path="opedrgent_locale" />
    <include domain="sharedpref" path="note_search_history" />
    <include domain="sharedpref" path="voiceprint_prefs" />
    <include domain="sharedpref" path="vocabulary" />

    <!-- 会话数据需要备份：卸载重装后可恢复 -->
    <include domain="file" path="research_store.json" />
    <include domain="file" path="research_store.json.bak" />
</full-backup-content>
