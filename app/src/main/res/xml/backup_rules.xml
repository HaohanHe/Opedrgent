<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!-- API Key、WebDAV 密码、MCP 认证头等敏感信息不参与云端备份 -->
    <exclude domain="sharedpref" path="opedrgent_secure.xml" />
    <exclude domain="sharedpref" path="opedrgent_webdav.xml" />
    <exclude domain="sharedpref" path="mcp_servers.xml" />

    <!-- 用户设置与数据需要备份：卸载重装后可恢复 -->
    <include domain="sharedpref" path="opedrgent_settings.xml" />
    <include domain="sharedpref" path="opedrgent_memory.xml" />
    <include domain="sharedpref" path="opedrgent_skills.xml" />
    <include domain="sharedpref" path="opedrgent_automations.xml" />
    <include domain="sharedpref" path="opedrgent_todos.xml" />
    <include domain="sharedpref" path="opedrgent_skill_loader.xml" />
    <include domain="sharedpref" path="opedrgent_user.xml" />
    <include domain="sharedpref" path="opedrgent_locale.xml" />
    <include domain="sharedpref" path="note_search_history.xml" />
    <include domain="sharedpref" path="voiceprint_prefs.xml" />
    <include domain="sharedpref" path="vocabulary.xml" />

    <!-- 会话数据需要备份：卸载重装后可恢复 -->
    <include domain="file" path="research_store.json" />
    <include domain="file" path="research_store.json.bak" />

    <!-- 导出目录不参与备份 -->
    <exclude domain="file" path="exports" />
</full-backup-content>
