    <string name="onboarding_page_welcome_title">Welcome to Opedrgent</string>
    <string name="onboarding_page_welcome_subtitle">Your local-first, extensible AI assistant. Chat, notes, knowledge graph, full-duplex voice, and dynamic skills grow together — making AI your external brain.</string>
    <string name="onboarding_page_chat_title">Chat Anytime</string>
    <string name="onboarding_page_chat_subtitle">Supports multi-turn conversation, tool invocation, web search, and deep research. When needed, the AI will proactively confirm and will not perform sensitive operations without permission.</string>
    <string name="onboarding_page_notes_title">Notes &amp; Knowledge Graph</string>
    <string name="onboarding_page_notes_subtitle">Capture inspirations, meetings, images, and links. After saving, the system automatically builds a knowledge graph to help you discover hidden connections between notes.</string>
    <string name="onboarding_page_sprout_title">Thought Space Sprout</string>
    <string name="onboarding_page_sprout_subtitle">Trigger a sprout on any note, and the AI will deeply analyze from multiple perspectives, generating inspiration connections, insights, and action suggestions. You can re-sprout using results as seeds.</string>
    <string name="onboarding_page_interview_title">Full-Duplex Voice Interview</string>
    <string name="onboarding_page_interview_subtitle">Supports real-time full-duplex voice conversation with hardware AEC echo cancellation, VAD voice detection, and smart barge-in. Ideal for mock interviews, speaking practice, and in-depth conversations.</string>
    <string name="onboarding_page_offline_title">Local First, Privacy Controllable</string>
    <string name="onboarding_page_offline_subtitle">Data is stored on-device by default. Load local models such as Gemma 4 for fully offline operation, or configure cloud APIs on demand.</string>

